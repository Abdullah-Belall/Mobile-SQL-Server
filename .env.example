DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE=RestDB
# Optional, default 30 minutes (backup / mission can be slow)
DB_REQUEST_TIMEOUT_MS=1800000

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Folder on the SQL Server machine. Empty = SQL Server's default backup folder.
BACKUP_DIR=
